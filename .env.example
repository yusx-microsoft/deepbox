# Copy to .env on the Server Host only. Never commit the real .env.
# AGENTBRIDGE_* takes precedence; existing DEEPBOX_* values remain supported.
# An explicit empty AGENTBRIDGE_* value disables its legacy fallback.
# State, database paths and protocol identities are not migrated by this rename.
AGENTBRIDGE_ENV=production
AGENTBRIDGE_SECRET=replace-with-a-long-random-value
AGENTBRIDGE_DATABASE_URL=sqlite:///C:/deepbox-data/deepbox.db
AGENTBRIDGE_DATA_DIR=C:/deepbox-data

# The HTTPS URL printed by `tailscale serve` (no trailing slash).
AGENTBRIDGE_PUBLIC_URL=https://your-server.your-tailnet.ts.net
AGENTBRIDGE_ALLOWED_ORIGINS=https://your-server.your-tailnet.ts.net
AGENTBRIDGE_COOKIE_SECURE=true
AGENTBRIDGE_COOKIE_SAMESITE=lax

# Authentication mode: local, hybrid, or microsoft. Microsoft/hybrid mode must
# run behind correctly configured Azure App Service Easy Auth.
AGENTBRIDGE_AUTH_MODE=local
AGENTBRIDGE_SESSION_TTL_SECONDS=28800
# Microsoft-authenticated emails allowed to claim a new installation owner.
AGENTBRIDGE_MICROSOFT_OWNER_EMAILS=
# Comma-separated Entra tenant IDs accepted after Easy Auth validation. Required
# for Microsoft or hybrid authentication in production.
AGENTBRIDGE_MICROSOFT_ALLOWED_TENANT_IDS=
AGENTBRIDGE_WORKSPACE_INVITATION_TTL_DAYS=7

# Uvicorn stays loopback-only; Tailscale Serve is the TLS/WSS entry point.
AGENTBRIDGE_HOST=127.0.0.1
AGENTBRIDGE_PORT=8077

# Deployment platform: local (default; laptop / Tailscale) or azure-app-service.
# Only azure-app-service is permitted to bind 0.0.0.0 in production.
AGENTBRIDGE_PLATFORM=local
# Trusted reverse-proxy hops for uvicorn X-Forwarded-* handling.
# Defaults to 127.0.0.1 (local) / * (azure-app-service).
AGENTBRIDGE_FORWARDED_ALLOW_IPS=127.0.0.1
# Self-service registration. Defaults to false in production; set true only if
# you deliberately want open sign-up. The route returns 403 when disabled.
AGENTBRIDGE_REGISTRATION_ENABLED=false

# Security baseline. Rate limiting defaults to enabled in production; values are
# fixed-window requests per minute for general API, login, and token routes.
AGENTBRIDGE_RATE_LIMIT_ENABLED=true
AGENTBRIDGE_RATE_LIMIT_API_PER_MINUTE=300
AGENTBRIDGE_RATE_LIMIT_LOGIN_PER_MINUTE=10
AGENTBRIDGE_RATE_LIMIT_TOKEN_PER_MINUTE=20

# One-time bootstrap token to create the FIRST owner account. Set to a long
# random value on first deploy, complete first-owner setup at /, then REMOVE
# it. Only its SHA-256 hash is held in memory; the plaintext is never stored,
# logged, or echoed. Placeholder only — replace before use.
AGENTBRIDGE_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-value

# --- Observability & capacity (Cut 3: minimal production ops) ---
# Log verbosity for the structured JSON logger (DEBUG/INFO/WARNING/ERROR).
AGENTBRIDGE_LOG_LEVEL=INFO
# Build provenance for deployed artifacts that ship without a .git directory
# (e.g. Azure App Service). Set to the deployed commit SHA at build time.
# Left unset locally, the server reads the commit from git directly.
AGENTBRIDGE_GIT_COMMIT=
# Capacity thresholds. Database size is measured in MB (larger is worse);
# recording-disk FREE space is measured in MB (smaller is worse). The
# /api/admin/capacity endpoint reports ok/warn/alert against these bounds.
# Constraint: DB alert >= DB warn; disk-free alert <= disk-free warn.
AGENTBRIDGE_DB_SIZE_WARN_MB=256
AGENTBRIDGE_DB_SIZE_ALERT_MB=1024
AGENTBRIDGE_DISK_FREE_WARN_MB=1024
AGENTBRIDGE_DISK_FREE_ALERT_MB=256
